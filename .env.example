# Use the SAME Supabase project as the student site (VAL / B.M.O).
# Copy to .env.local and fill in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Never put the service_role / secret key in this app. It isn't needed:
# the dashboard reads data through admin-only SQL functions (supabase/admin_dashboard.sql).
